# Publish only source, the guide, lightweight examples, and portable tests.
/*
!/basat/
!/docs/
!/data/
!/tests/
!/scripts/
!/.gitignore
!/LICENSE
!/README.md
!/pyproject.toml
!/uv.lock

/docs/*
!/docs/basat_user_guide.ipynb
!/docs/reproduction.md

/data/*
!/data/README.md
!/data/manifest.json
!/data/native_manifest.json
!/data/stochastic/
!/data/contextual/
!/data/distributional/
!/data/adversarial/

/scripts/*
!/scripts/prepare_release.py

# These developer checks use private campaign artifacts or local generators.
/tests/test_guide_completed_cache.py
/tests/test_guide_presentation.py
/tests/test_mhc_confidence_sensitivity.py
/tests/test_cgp_sensor_notebook.py
/tests/test_mhc_notebook.py
/tests/test_mhc_seed_search.py
/tests/test_mhc_reference.py

# Ignore generated files inside the library as well.
__pycache__/
*.py[cod]
*.egg-info/
.DS_Store
.ipynb_checkpoints/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv*/
dist/
build/
.coverage
htmlcov/
