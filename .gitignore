# Publish only source, the guide, and lightweight examples.
/*
!/basat/
!/docs/
!/data/
!/.gitignore
!/LICENSE
!/README.md
!/pyproject.toml

/docs/*
!/docs/basat_user_guide.ipynb
!/docs/reproduction.md

/data/*
!/data/README.md
!/data/manifest.json
!/data/native_manifest.json
!/data/stochastic/
!/data/contextual/
!/data/distributional/
!/data/adversarial/

# Local development files remain outside the published project.
/scripts/
/tests/
/uv.lock

# Ignore generated files inside the library as well.
__pycache__/
*.py[cod]
*.egg-info/
.DS_Store
.ipynb_checkpoints/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv*/
dist/
build/
.coverage
htmlcov/
